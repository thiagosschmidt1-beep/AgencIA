# meta-ads-agents — secrets do runner Fly.io
#
# Este arquivo é referência. Os valores reais vivem em:
#   - .env (local dev, gitignored)
#   - `fly secrets` (produção)
#
# Para sincronizar prod:
#   while IFS='=' read -r k v; do
#     [[ -z "$k" || "$k" =~ ^# ]] && continue
#     fly secrets set "$k=$v"
#   done < .env.local

# ---------- Claude / Anthropic ----------
# Fallback para SDK quando OAuth do CLI não cobrir (ex.: skills que chamam Anthropic API direto).
CLAUDE_API_KEY=sk-ant-...

# ---------- OpenAI (image-generate + STT Whisper do Nexus) ----------
OPENAI_API_KEY=sk-...

# ---------- Supabase ----------
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-side, bypassa RLS. Substitui a legacy SUPABASE_SERVICE_ROLE_KEY (JWT).
SUPABASE_SECRET_KEY=sb_secret_...
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
# Client-side. Substitui a legacy SUPABASE_ANON_KEY (JWT).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# ---------- Upstash Redis (memória de sessão do Nexus + rate limits) ----------
UPSTASH_REDIS_REST_URL=https://<id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXX...

# ---------- Budget caps (HARD limits respeitados pelas skills) ----------
WORKSPACE_MAX_DAILY_BUDGET_CENTS=5000
WORKFLOW_LLM_BUDGET_USD_CAP=2.00

# ---------- Cloudflare Turnstile (captcha anti-brute-force no login do dashboard) ----------
# Opcional: sem o SECRET o endpoint de login pula a verificação de captcha (dev/testes).
# A SITE key é pública por design (lida no server e passada ao client). Console:
# https://dash.cloudflare.com/?to=/:account/turnstile
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ---------- Telegram (notificação das análises) ----------
# chat_id de destino do resumo da skill funnel-analytics-cliente-exemplo-campaign.
# Opcional: se ausente, a skill degrada para log-only (não falha). Em prod vai por `fly secrets`.
TELEGRAM_CHAT_ID=

# ---------- Web dashboard (Vercel / web/) ----------
# Gate de acesso do operador: hash SHA-256 (hex) da senha do dashboard.
#   echo -n "minha-senha" | sha256sum
DASHBOARD_PASSWORD=<sha256-hex-da-senha>
# Segredo para assinar o cookie JWT de sessão (>= 32 bytes aleatórios).
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=<random-hex>
# ElevenLabs (TTS do Nexus).
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=<voice-id>

# ---------- Modelo do assistente Nexus (opcional — tem default no código) ----------
# Default: claude-sonnet-4-6. Sobrescreva para trocar o modelo do chat.
NEXUS_MODEL=
