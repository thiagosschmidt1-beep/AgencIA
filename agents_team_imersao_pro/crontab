4  10 * * * /app/scripts/run-skill.sh create-traffic-campaign client_slug=clorin
5  10 * * * /app/scripts/run-skill.sh create-traffic-campaign client_slug=coutinho
6  10 * * * /app/scripts/run-skill.sh create-traffic-campaign client_slug=dolcevivere
7  10 * * * /app/scripts/run-skill.sh create-traffic-campaign client_slug=lulibaby
8  10 * * * /app/scripts/run-skill.sh create-traffic-campaign client_slug=originalflex
9  10 * * * /app/scripts/run-skill.sh create-traffic-campaign client_slug=piemon
10 10 * * * /app/scripts/run-skill.sh create-traffic-campaign client_slug=armando
# ── Piemon: múltiplos tipos de campanha (escalonados, um por minuto) ───────────
11 10 * * * /app/scripts/run-skill.sh create-traffic-campaign client_slug=piemon campaign_type=AWARENESS
12 10 * * * /app/scripts/run-skill.sh create-traffic-campaign client_slug=piemon campaign_type=TRAFFIC_WHATSAPP whatsapp=5569840811139 angle=vagas
13 10 * * * /app/scripts/run-skill.sh create-traffic-campaign client_slug=piemon campaign_type=TRAFFIC_WHATSAPP whatsapp=5569999637440 angle=ofertas
