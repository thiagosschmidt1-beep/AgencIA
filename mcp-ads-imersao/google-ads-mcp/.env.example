# Developer token do MCC (Ferramentas > API Center) - precisa de aprovacao do Google
GOOGLE_ADS_DEVELOPER_TOKEN=seu_developer_token_aqui

# Credenciais OAuth do projeto no Google Cloud (tipo: Desktop app)
GOOGLE_ADS_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=seu_client_secret_aqui
GOOGLE_ADS_REFRESH_TOKEN=seu_refresh_token_aqui
GOOGLE_ADS_GCP_REDIRECT_URL=https://seu-dominio.ngrok-free.dev/google/api/

# ID do MCC gerenciador, so digitos e sem hifen (opcional, mas necessario se a
# conta operada e gerenciada por um MCC)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=seu_mcc_id_aqui

# Opcional: versao da API (default v24)
# GOOGLE_ADS_API_VERSION=v24

# Obrigatorio quando o servidor estiver publicado na Vercel.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=gere_um_token_seguro_aqui

# URLs
# Ngrok Configuration
# command
# ngrok http --url=seu-dominio.ngrok-free.dev

NGROK_ENABLED=true # Altere para false quando não quiser usar ngrok
NGROK_URL=https://seu-dominio.ngrok-free.dev
NGROK_LOCAL_PORT=10000
